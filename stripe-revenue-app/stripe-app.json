{
  "$schema": "https://stripe.com/stripe-app.schema.json",
  "id": "com.worksapp.rocket-revenue-verification",
  "name": "Rocket Revenue Verification",
  "version": "0.1.2",
  "icon": "./rocket-icon.png",
  "permissions": [
    {
      "permission": "subscription_read",
      "purpose": "Read subscription status, recurring items, and quantities for selected-app MRR."
    },
    {
      "permission": "product_read",
      "purpose": "Show product names and verify the founder's selected product mappings."
    },
    {
      "permission": "plan_read",
      "purpose": "Read recurring price amounts and intervals for selected-app MRR."
    }
  ],
  "allowed_redirect_uris": [
    "https://lcujmvdgczkjxdstzhnr.supabase.co/functions/v1/rocket-stripe-revenue"
  ],
  "distribution_type": "public",
  "stripe_api_access_type": "oauth",
  "sandbox_install_compatible": true
}
